# This file documents names only. Generate LOCAL disposable service secrets with:
# python3 scripts/local-setup.py
# apps/web/.dev.vars (ignored; local/staging synthetic probes only)
STORAGE_KEY=
A2A_TOKEN=
CONTEXT_TOKEN=
SETUP_TOKEN=
# apps/cre/.env (ignored; same scoped service secrets)
SECRET_A2A_TOKEN=
SECRET_CONTEXT_TOKEN=
# Root .env: dedicated Arc testnet wallet (chainId 5042002).
# Keep the private key local; do not add it to the web Worker or this example.
# Creating/funding the wallet does not authorize transaction broadcasts.
ARC_WALLET_ADDRESS=
CRE_ETH_PRIVATE_KEY=

# Job marketplace: keep disabled until evaluator deployment and verification.
JOBS_ENABLED=false
JOB_EVALUATOR_CODE_HASH=
JOB_EVALUATOR=
JOB_PRICE_ATOMIC=10000
ESCROW_CODE_HASH=
ESCROW_IMPLEMENTATION_HASH=
JOB_CONTEXT_TOKEN=
JOB_OPERATOR_TOKEN=
# .local/staging-jobs.env: A2A token + dedicated context secret for CRE.
SECRET_JOB_CONTEXT_TOKEN=
# Optional read-only Foundry fork tests. No testnet transaction broadcasts.
ARC_FORK_RPC=https://rpc.testnet.arc.io

# Isolated autonomous provider (.local/provider.env); never load its key in Workers.
# Separate service credential; no access to buyer policy or CRE context.
PROVIDER_SERVICE_TOKEN=
PROVIDER_A2A_TOKEN=
PROVIDER_PRIVATE_KEY=
PROVIDER_MAX_BUDGET_ATOMIC=10000
PROVIDER_MAX_TX_GAS_USDC=0.02
PROVIDER_TOTAL_GAS_USDC=0.05
# Broadcasting remains OFF. Supply ALLOW_PROVIDER_BROADCAST=yes explicitly
# and pass --broadcast only after authorization for the bounded test run.

# Set true only after the autonomous signer is running and verified.
PROVIDER_AUTOMATION_ENABLED=false

# Required for a bounded provider broadcast run; one real request only.
PROVIDER_REQUEST_ID=
