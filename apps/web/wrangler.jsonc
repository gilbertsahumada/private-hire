{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "confidential-agent-jobs-staging",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {"directory": ".open-next/assets", "binding": "ASSETS"},
  "observability": {"enabled": false},
  "vars": {"PUBLIC_ORIGIN": "http://127.0.0.1:8787", "ENABLE_PROBE": "true"},
  "d1_databases": [{"binding": "DB", "database_name": "confidential-agent-jobs-staging", "database_id": "00000000-0000-0000-0000-000000000001", "migrations_dir": "migrations"}],
  "r2_buckets": [{"binding": "PRIVATE_DATA", "bucket_name": "confidential-agent-jobs-private-staging"}]
}
