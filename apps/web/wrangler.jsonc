{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "confidential-agent-jobs-staging",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": false,
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://confidential-agent-jobs-staging.gilbertsahumada.workers.dev",
    "ENABLE_PROBE": "true",
    "JOBS_ENABLED": "false",
    "JOB_EVALUATOR": "0x391579ce844b95fc871fa9ce0af1ac8208418962",
    "JOB_EVALUATOR_CODE_HASH": "0xc6948c95c8c8d08c1f09a1c367ae1407f1b53e1720960332bb0299aa9e23e248",
    "ESCROW_CODE_HASH": "0x6fbb70f32c57790a7bc472b3fd6adb3bc22e911239f1a86f77898e69f62d5d13",
    "ESCROW_IMPLEMENTATION_HASH": "0x7054f89cadf92af85003313db92e9b29ef670ee2c7a20b5295cdddf66ecaa4b3",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "confidential-agent-jobs-staging",
      "database_id": "52155584-f6b0-448c-b3f4-1c86c3e80381",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "PRIVATE_DATA",
      "bucket_name": "confidential-agent-jobs-private-staging",
    },
  ],
}
