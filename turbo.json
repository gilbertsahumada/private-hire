{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        ".open-next/**",
        "out/**"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "simulate": {
      "cache": false
    },
    "preview": {
      "cache": false,
      "persistent": true
    },
    "deploy": {
      "cache": false
    },
    "@private-hire/cre#build": {
      "dependsOn": ["^build"],
      "outputs": ["probe/binary.wasm"]
    }
  }
}
